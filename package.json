{
  "name": "nestjs-docfy",
  "version": "0.9.0",
  "description": "Keep your NestJS controllers clean — Swagger docs live in a separate companion file by naming convention",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "require": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js"
    }
  },
  "bin": {
    "nestjs-docfy": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "decorator",
    "documentation",
    "companion",
    "nestjs-swagger",
    "nestjs-openapi",
    "nestjs-module",
    "nestjs-decorator",
    "nestjs-clean",
    "swagger-decorator",
    "swagger-companion",
    "openapi-decorator",
    "controller-docs",
    "clean-controller",
    "separation-of-concerns",
    "developer-experience",
    "dx",
    "typescript",
    "reflect-metadata"
  ],
  "author": "Marvin Rocha",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarvinRF/nest-docfy.git"
  },
  "homepage": "https://github.com/MarvinRF/nest-docfy#readme",
  "bugs": {
    "url": "https://github.com/MarvinRF/nest-docfy/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@fastify/static": "^8.0.0 || ^9.0.0",
    "@nestjs/common": ">=9.0.0",
    "@nestjs/swagger": ">=6.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@fastify/static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fastify": "^5.10.0",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "semantic-release": "^25.0.8",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "docfy-ui": "^0.5.0",
    "express": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "picocolors": "^1.1.1",
    "source-map": "^0.6.1",
    "ts-morph": "^28.0.0"
  },
  "overrides": {
    "swagger-ui-dist": "5.17.14"
  }
}
