{
  "name": "nestjs-docfy",
  "version": "0.3.1",
  "description": "Keep your NestJS controllers clean — Swagger docs live in a separate companion file by naming convention",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "require": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "bin": {
    "nestjs-docfy": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "decorator",
    "documentation",
    "companion",
    "nestjs-swagger",
    "nestjs-openapi",
    "nestjs-module",
    "nestjs-decorator",
    "nestjs-clean",
    "swagger-decorator",
    "swagger-companion",
    "openapi-decorator",
    "controller-docs",
    "clean-controller",
    "separation-of-concerns",
    "developer-experience",
    "dx",
    "typescript",
    "reflect-metadata"
  ],
  "author": "Marvin Rocha",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarvinRF/nest-docfy.git"
  },
  "homepage": "https://github.com/MarvinRF/nest-docfy#readme",
  "bugs": {
    "url": "https://github.com/MarvinRF/nest-docfy/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/swagger": ">=6.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "docfy-ui": "^0.0.1",
    "express": "^5.0.0",
    "picocolors": "^1.1.1",
    "source-map": "^0.6.1",
    "ts-morph": "^28.0.0"
  },
  "overrides": {
    "swagger-ui-dist": "5.17.14"
  }
}
